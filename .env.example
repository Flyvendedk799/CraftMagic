# Copy to .env and fill in. Never commit the real file.

# --- server ---
PORT=3016
HOST=0.0.0.0
# Absolute origin the mod is handed for fetching build data. Must be https in production.
PUBLIC_ORIGIN=http://localhost:3016

# --- database ---
DATABASE_URL=postgres://imaginecraft:imaginecraft@localhost:55432/imaginecraft

# --- auth ---
# Random 32+ bytes. Generate with: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- AI generation (needed from M2 onward) ---
ANTHROPIC_API_KEY=
