{
  "name": "craftmagic",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspace @craftmagic/core && npm run build --workspace @craftmagic/web && npm run build --workspace @craftmagic/server",
    "dev": "npm run dev --workspace @craftmagic/server",
    "dev:web": "npm run dev --workspace @craftmagic/web",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "tsc -b packages/core apps/server apps/web --pretty"
  },
  "devDependencies": {
    "pngjs": "^7.0.0",
    "typescript": "^5.7.2"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.21.5": true,
    "@flyvendedk799/ai-auth@0.4.0": true
  }
}
